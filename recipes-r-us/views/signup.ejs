<%- include("partials/sign-header.ejs") %>

    <div class="sign-container">
        <div class="sign-object">
            <form id="sign-up-form" action="/signup" method="POST">
                <div class="form-container">
                    <div class="close">
                        <a href="../">
                            <span>&times;</span>
                        </a>
                    </div>
                    <div class="form-object">
                        <div class="view-recipe-img">
                            <img src="/images/icons/user.png" alt="Image of">
                        </div>
                    </div>
                    <h2>Sign Up</h2>
                    <div class="form-object">
                        <input type="text" name="name" placeholder="Full Name*" required>
                    </div>
                    <div class="form-object">
                        <input type="text" name="user_id" placeholder="Username*" required>
                    </div>
                    <div class="form-object">
                        <input type="password" name="password" placeholder="Password*" required>
                    </div>
                    <div class="form-object">
                        <input type="submit" value="Submit">
                    </div>
                </div>
            </form>
        </div>
        <% if (locals.response) { %>
            <div class="sign-object">
                <h4><%= response %></h4>
            </div>
        <% } %>
    </div>
</body>
</html>

