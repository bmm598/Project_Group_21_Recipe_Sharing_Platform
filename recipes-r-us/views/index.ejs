<%- include("partials/header.ejs") %>

<!-- search box -->
<div class="body-container">
    <div class="body-object">
        <form action="/" method="GET" id="search-form" class="form-container">
            <div class="form-object">
                <input
                    type="text"
                    name="q"
                    placeholder="Search recipes by title, description, or tags"
                    value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                >
            </div>
            <div class="form-object">
                <input type="submit" value="Search">
            </div>
        </form>
    </div>
</div>

<!-- if recipes list exists -->
<% if (locals.recipes) { %>
    <div class="recipe-container">
        <!-- for each recipe in recipes create this object -->
        <% recipes.forEach(recipe => { %>
            <div class="recipe-object">
                    <%= recipe.date_created %> 
                <h3> 
                    <%= recipe.title %> 
                </h3>
                <p> 
                    by: <%= recipe.creator_name %> 
                </p>
                <img src="<%= recipe.img %>" alt="Image of <%= recipe.title %>">
                <p> 
                    <%= recipe.body %> 
                </p>

                <!-- tags block -->
                <% if (recipe.tags) { %>
                    <div class="tag-container">
                        <% recipe.tags.split(",").forEach((tagRaw) => { 
                            const t = tagRaw.trim();
                            if (t.length === 0) return;
                        %>
                            <a
                                class="tag-badge"
                                href="/?tag=<%= encodeURIComponent(t) %><%= (typeof searchQuery !== 'undefined' && searchQuery.trim() !== '') ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                            >
                                <%= t %>
                            </a>
                        <% }) %>
                    </div>
                <% } %>

                <!-- if the current user is the owner of this post, then show edit and delete -->
                <% if(locals.loggedIn == true) { %>
                    <% if(locals.user[0].creator_id == recipe.creator_user_id) { %>
                    <div class="edit-object">
                        <form id="delete-form" action="<%= recipe.recipe_id %>/delete" method="POST">
                            <div class="form-object">
                                <input type="submit" value="Delete">
                            </div>
                        </form>
                        <form id="edit-form" action="<%= recipe.recipe_id %>/edit" method="GET">
                            <div class="form-object">
                                <input type="submit" value="Edit">
                            </div>
                        </form>
                    </div>
                    <% } %>
                <% } %>
            </div>
        <% }); %>
    </div>
<% } %>

<!-- if user is logged in then allow them to draft a recipe post -->
<% if(locals.loggedIn == true) { %>
<div class="body-container">
        <div class="body-object">
            <h2>Draft a Recipe Post</h2>
        </div>
        <div class="body-object">
            <form id="recipe-form" action="/submit" method="POST">
                <div class="form-container">
                    <!-- title -->
                    <div class="form-object">
                        <input
                            type="text"
                            name="title"
                            placeholder="Recipe Title*"
                            required
                        >
                    </div>

                    <!-- creator -->
                    <div class="form-object">
                        <p>
                            by: <%= user[0].name %>
                        </p>
                    </div>

                    <!-- description -->
                    <div class="form-object">
                        <textarea
                            name="content"
                            placeholder="Short description or notes about the recipe*"
                            required
                        ></textarea>
                    </div>

                    <!-- ingredients -->
                    <div class="form-object">
                        <textarea
                            name="ingredients"
                            placeholder="Ingredients* (one per line)"
                            required
                        ></textarea>
                    </div>

                    <!-- instructions -->
                    <div class="form-object">
                        <textarea
                            name="instructions"
                            placeholder="Instructions*"
                            required
                        ></textarea>
                    </div>

                    <!-- tags & badges -->
                    <div class="form-object">
                        <input
                            type="text"
                            name="tags"
                            placeholder="Tags (comma-separated, e.g. vegan, breakfast, spicy)"
                        >
                    </div>

                    <!-- diet preference -->
                    <div class="form-object">
                        <input
                            type="text"
                            name="diet"
                            placeholder="Dietary preference (e.g. Vegan, Gluten-free)"
                        >
                    </div>

                    <!-- cook time -->
                    <div class="form-object">
                        <input
                            type="number"
                            name="cook_time"
                            min="0"
                            placeholder="Cooking time (minutes)"
                        >
                    </div>

                    <!-- difficulty -->
                    <div class="form-object">
                        <select name="difficulty">
                            <option value="">Select difficulty</option>
                            <option value="Easy">Easy</option>
                            <option value="Medium">Medium</option>
                            <option value="Hard">Hard</option>
                        </select>
                    </div>

                    <!-- image url -->
                    <div class="form-object">
                        <input
                            type="url"
                            name="img"
                            placeholder="Image URL (optional)"
                        >
                    </div>

                    <!-- submit -->
                    <div class="form-object">
                        <input type="submit" value="Submit Recipe">
                    </div>
                </div>
            </form>
        </div>
</div>
<% } %>

<%- include("partials/footer.ejs") %>