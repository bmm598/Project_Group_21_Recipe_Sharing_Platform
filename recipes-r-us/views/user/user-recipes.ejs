<%- include("../partials/header.ejs") %>

<div class="search-bar-container">
    <form action="/search" method="post">   
        <div class="search-bar-object">
            <label for="search-input">Search:</label>
            <input type="search" id="search-input" name="q" placeholder="Enter your search term..." />
            <button type="submit">Search</button>
        </div>
    </form>
</div>

<!-- if recipes list exists -->
<% if (locals.user_recipes) { %>
    <div class="recipe-container">
        <!-- for each recipe in recipes create this object -->
        <% user_recipes.forEach(recipe => { %>
            <div class="recipe-object">
                <a href="<%= __dirname %><%= recipe.recipe_id %>/recipe">
                <div class="recipe-split">
                    <div class="recipe-img">
                        <img src="<%= recipe.img %>" alt="Image of <%= recipe.title %>">
                    </div>
                    <div class="recipe-description">
                        <div>
                            <%= recipe.date_created %> 
                        </div>
                        <h3> 
                            <%= recipe.title %> 
                        </h3>
                        <div>by: <%= recipe.creator_name %> </div>
                        <div class="star-rating" id="starRating">
                            <span class="star <%= recipe.avg_rating > 1? "checked" : null %>">&#9733;</span>
                            <span class="star <%= recipe.avg_rating > 2? "checked" : null %>">&#9733;</span>
                            <span class="star <%= recipe.avg_rating > 3? "checked" : null %>">&#9733;</span>
                            <span class="star <%= recipe.avg_rating > 4? "checked" : null %>">&#9733;</span>
                            <span class="star <%= recipe.avg_rating == 5? "checked" : null %>">&#9733;</span>
                        </div>
                        <p>
                            <%= recipe.body %> 
                        </p>
                        <!-- if the current user is the owner of this post, then show edit and delete -->
                        <% if(locals.loggedIn == true) { %>
                            <% if(locals.user[0].creator_id == recipe.creator_user_id) { %>
                            <div class="edit-object">
                                <form id="delete-form" action="<%= __dirname %><%= recipe.recipe_id %>/delete" method="POST">
                                    <div class="form-object">
                                        <input type="submit" value="Delete">
                                    </div>
                                </form>
                                <form id="edit-form" action="<%= __dirname %><%= recipe.recipe_id %>/edit" method="GET">
                                    <div class="form-object">
                                        <input type="submit" value="Edit">
                                    </div>
                                </form>
                            </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
                </a>
            </div>
        <% }); %>
    </div>
<% } %>

<%- include("../partials/footer.ejs") %>