<%- include("partials/header.ejs") %>

<div class="recipe-body-container">
    <div class="view-recipe-container">
        <div class="view-recipe-ingredients">
            <% if (recipe.img) { %>
            <img class="view-recipe-img" src="<%= recipe.img %>" alt="Image of <%= recipe.title %>">
            <% } %>
        </div>
        <div class="view-recipe-instructions">
            <h1><%= recipe.title %></h1>
            <p>
                <%= recipe.date_created %> 
            </p>
            <p>
                by: <%= recipe.creator_name %>
            </p>
            <p>
                <%= recipe.body %>
            </p>
            <p class="body-object">
                Diet: <%= recipe.diet %>
            </p>
            <p class="body-object">
                Difficulty: <%= recipe.difficulty %>
            </p>
        </div>
    </div>
    <div class="view-recipe-container">
        <% if (recipe.ingredients) { %>
        <div class="view-recipe-ingredients">
            <h1>Ingredients</h1>
            <% recipe.ingredients.split(",").forEach((ingredient) => { %>
                <p><%= ingredient %></p>
            <% }); %>
        </div>
        <% } %>
        <% if (recipe.instructions) { %>
        <div class="view-recipe-instructions">
            <h1>Steps</h1>
            <span class="timer"><img src="/images/icons/clock.png" alt="clock-icon"> <%= recipe.cook_time %> Minutes</span>
            <ol>
            <% recipe.instructions.split(",").forEach((instruction) => { %>
                <li><p><%= instruction %></p></li>
            <% }); %>
            </ol>
        </div>
        <% } %>
    </div>
</div>
<div class="body-container">
    <div class="star-rating" id="starRating">
        <span class="star <%= recipe.avg_rating >= 1 ? 'checked' : '' %>">&#9733;</span>
        <span class="star <%= recipe.avg_rating >= 2 ? 'checked' : '' %>">&#9733;</span>
        <span class="star <%= recipe.avg_rating >= 3 ? 'checked' : '' %>">&#9733;</span>
        <span class="star <%= recipe.avg_rating >= 4 ? 'checked' : '' %>">&#9733;</span>
        <span class="star <%= recipe.avg_rating >= 5 ? 'checked' : '' %>">&#9733;</span>
    </div>
    <p>
        <%= recipe.avg_rating %> average based on <%= recipe.total_ratings? recipe.total_ratings : 0 %> reviews. 
    </p>

    <% if (loggedIn) { %>
        <form
            action="/<%= recipe.recipe_id %>/save"
            method="POST"
            class="save-recipe-form"
        >
            <button type="submit" class="save-recipe-button">
                <%= isSaved ? "★ Saved" : "☆ Save" %>
            </button>
        </form>
    <% } else { %>
        <p class="save-recipe-login-message">
            <a href="/signin">Sign in to save this recipe.</a>
        </p>
    <% } %>
</div>

<% if (locals.loggedIn) { %>
<div class="body-container">
    <div class="body-object">
            <form id="make-comment" action="/<%= recipe.recipe_id %>/post-comment" method="POST">
                <div class="comment-form-container">
                    <div class="comment-form-rating">
                        <input
                            type="range"
                            name="rating"
                            min="1"
                            max="5"
                            required
                            list="markers"
                        >
                        <datalist id="markers">
                            <option value="1" label="1 Star"></option>
                            <option value="2" label="2 Star"></option>
                            <option value="3" label="3 Star"></option>
                            <option value="4" label="4 Star"></option>
                            <option value="5" label="5 Star"></option>
                        </datalist>
                        <div class="rating">
                            <span class="star checked" data-value="1">&#9733;</span>
                            <span class="star checked" data-value="2">&#9733;</span>
                            <span class="star checked" data-value="3">&#9733;</span>
                            <span class="star checked" data-value="4">&#9733;</span>
                            <span class="star checked" data-value="5">&#9733;</span>
                        </div>
                    </div>
                    <div class="comment-form-object">
                        <p>
                            by: <%= user[0].name %>
                        </p>
                    </div>
                    <div class="comment-form-object">
                        <textarea
                            name="content"
                            placeholder="Your comment*"
                            required
                        ></textarea>
                    </div>
                    <div class="comment-form-object">
                        <input type="submit" value="Submit comment">
                    </div>
                </div>
            </form>
    </div>
</div>
<% } else { %>
    <div class="body-container">
        <div class="body-object">
            <p class="user-rating-login-message">
                <a href="/signin">Sign in to rate this recipe.</a>
            </p>
        </div>
    </div> 
<% } %> 

<comment>
    <% if (locals.comments) { %>
    <div class="comment-container">
        <% comments.forEach(comment => { %>
            <div class="comment-object">
                <div>
                    <%= comment.date_created %> 
                </div>
                <p>
                    by: <%= comment.commenter_name %>
                </p>
                <p>
                    <%= comment.comment_text %>
                </p>
            </div>
        <% }) %>
    </div>
    <% } %>
</comment>

<%- include("partials/footer.ejs") %>